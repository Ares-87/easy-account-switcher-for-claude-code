{
  "name": "easy-account-switcher-for-claude-code",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.1.0",
  "publisher": "aresdesign",
  "author": "AresDesign",
  "license": "MIT",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#1F1E1D",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Ares-87/easy-account-switcher-for-claude-code.git"
  },
  "bugs": {
    "url": "https://github.com/Ares-87/easy-account-switcher-for-claude-code/issues"
  },
  "homepage": "https://github.com/Ares-87/easy-account-switcher-for-claude-code#readme",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "claude",
    "claude code",
    "anthropic",
    "account",
    "switcher",
    "easy account switcher",
    "profile",
    "multi-account",
    "windows"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "l10n": "./l10n",
  "contributes": {
    "commands": [
      {
        "command": "claudeCodeAccountSwitcher.menu",
        "title": "%cmd.menu%",
        "icon": "$(account)"
      },
      {
        "command": "claudeCodeAccountSwitcher.saveCurrent",
        "title": "%cmd.saveCurrent%"
      },
      {
        "command": "claudeCodeAccountSwitcher.add",
        "title": "%cmd.add%"
      },
      {
        "command": "claudeCodeAccountSwitcher.rename",
        "title": "%cmd.rename%"
      },
      {
        "command": "claudeCodeAccountSwitcher.remove",
        "title": "%cmd.remove%"
      }
    ],
    "keybindings": [
      {
        "command": "claudeCodeAccountSwitcher.menu",
        "key": "ctrl+alt+a"
      }
    ],
    "configuration": {
      "title": "Easy Account Switcher for Claude Code",
      "properties": {
        "claudeCodeAccountSwitcher.claudeConfigDir": {
          "type": "string",
          "default": "",
          "description": "%cfg.claudeConfigDir%"
        },
        "claudeCodeAccountSwitcher.autoReload": {
          "type": "boolean",
          "default": true,
          "description": "%cfg.autoReload%"
        }
      }
    }
  }
}
